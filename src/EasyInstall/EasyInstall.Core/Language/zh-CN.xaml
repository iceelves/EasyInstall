<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System ="clr-namespace:System;assembly=mscorlib">

    <!--公共-->
    <System:String x:Key="OK">确定</System:String>

    <!--主界面-->
    <System:String x:Key="InstallationWizard">安装向导</System:String>
    <System:String x:Key="ApplicationName">应用名称</System:String>
    <System:String x:Key="VersionNumber">版本号</System:String>
    <System:String x:Key="StartInstall">开始安装</System:String>
    <System:String x:Key="ReadAndAgree">阅读并同意</System:String>
    <System:String x:Key="UserLicenseAgreement">《用户许可协议》</System:String>
    <System:String x:Key="CustomSettings">自定义设置</System:String>
    <System:String x:Key="CreateDesktopShortcut">创建桌面快捷方式</System:String>
    <System:String x:Key="AddTaskbar">添加到任务栏</System:String>
    <System:String x:Key="BootStartup">开机自动启动</System:String>
    <System:String x:Key="DiskFreeSpace">磁盘可用空间：</System:String>
    <System:String x:Key="Installing">正在安装...</System:String>
    <System:String x:Key="InstallCompleted">安装完成</System:String>
</ResourceDictionary>