<Window x:Class="EasyInstall.Setup.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:control="clr-namespace:EasyInstall.Core.Controls;assembly=EasyInstall.Core"
        mc:Ignorable="d"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Icon="pack://application:,,,/EasyInstall.Core;component/images/Install.png"
        Title="{DynamicResource ConfirmExitTitle}" Height="175" Width="320">

    <Border SnapsToDevicePixels="True" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Border CornerRadius="8">
            <Border.Clip>
                <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,300,155"/>
            </Border.Clip>
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="#F5F6F8"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="{Binding RelativeSource={RelativeSource AncestorType=Window},Path=Icon}"
                               Width="16" Height="16" Margin="10,0,5,0"/>
                        <Label Content="{DynamicResource ConfirmExitTitle}" FontSize="12" Foreground="#333" Padding="0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- 消息内容 -->
                <TextBlock Grid.Row="1" Text="{DynamicResource ConfirmExitMessage}"
                           FontSize="13" Foreground="#333"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="20,0"/>

                <!-- 按钮区 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4">
                    <control:IceButton x:Name="BtnYes" Height="28" Width="80"
                                       Background="#4083FD" IsMouseOverFill="#256EEB"
                                       ButtonCornerRadius="4" Foreground="White"
                                       BorderThickness="0" Cursor="Hand"
                                       Content="{DynamicResource ConfirmExitYes}"
                                       Click="BtnYes_Click"/>
                    <control:IceButton x:Name="BtnNo" Height="28" Width="80" Margin="10,0,0,0"
                                       Background="#E8EAED" IsMouseOverFill="#D0D3D8"
                                       ButtonCornerRadius="4" Foreground="#333"
                                       BorderThickness="0" Cursor="Hand" IsCancel="True"
                                       Content="{DynamicResource ConfirmExitNo}"
                                       Click="BtnNo_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
