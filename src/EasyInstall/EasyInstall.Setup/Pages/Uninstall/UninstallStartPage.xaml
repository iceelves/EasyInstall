<Page x:Class="EasyInstall.Setup.Pages.Uninstall.UninstallStartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EasyInstall.Setup.Pages.Uninstall"
      mc:Ignorable="d" 
      xmlns:control="clr-namespace:EasyInstall.Core.Controls;assembly=EasyInstall.Core"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UninstallStartPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/EasyInstall.Core;component/images/Install.png" Width="100" Height="100" Margin="8"/>
            <Label x:Name="AppName" FontSize="24" HorizontalAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <control:IceButton x:Name="StartUninstall" Height="40" Width="160" Background="#4083FD" IsMouseOverFill="#256EEB" ButtonCornerRadius="4" VerticalAlignment="Top"
                               FontSize="14" Foreground="White" BorderThickness="0" IsDefault="True" Cursor="Hand"
                               Content="{DynamicResource StartUninstall}" IsEnabled="{Binding IsChecked, ElementName=ReadAndAgree}"
                               Click="StartUninstall_Click"/>
        </Grid>
    </Grid>
</Page>
