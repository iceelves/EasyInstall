<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <!--窗口标题-->
    <System:String x:Key="BuilderTitle">EasyInstall 打包工具</System:String>

    <!--菜单/工具栏-->
    <System:String x:Key="MenuFile">文件</System:String>
    <System:String x:Key="MenuNew">新建配置</System:String>
    <System:String x:Key="MenuOpen">导入配置</System:String>
    <System:String x:Key="MenuSave">导出配置</System:String>

    <!--基本信息-->
    <System:String x:Key="SectionBasicInfo">基本信息</System:String>
    <System:String x:Key="LabelAppName">应用名称</System:String>
    <System:String x:Key="LabelAppVersion">版本号</System:String>
    <System:String x:Key="LabelCompany">公司名称</System:String>
    <System:String x:Key="LabelCompanySimplify">公司简称</System:String>
    <System:String x:Key="LabelWebsite">官方网站</System:String>
    <System:String x:Key="LabelDefaultInstallDir">默认安装路径</System:String>
    <System:String x:Key="LabelRegistryKey">注册表键名</System:String>
    <System:String x:Key="LabelMainExecutable">主程序文件名</System:String>

    <!--快捷方式-->
    <System:String x:Key="SectionShortcuts">快捷方式与启动</System:String>

    <!--协议-->
    <System:String x:Key="SectionLicense">用户许可协议</System:String>
    <System:String x:Key="LabelLicenseText">协议内容</System:String>

    <!--图标-->
    <System:String x:Key="SectionIcons">程序图标</System:String>
    <System:String x:Key="LabelInstallIcon">安装程序图标</System:String>
    <System:String x:Key="LabelUninstallIcon">卸载程序图标</System:String>
    <System:String x:Key="BtnSelectIcon">选择图标...</System:String>
    <System:String x:Key="BtnClearIcon">清除</System:String>

    <!--文件列表-->
    <System:String x:Key="SectionFiles">安装文件</System:String>
    <System:String x:Key="BtnAddFiles">添加文件</System:String>
    <System:String x:Key="BtnAddFolder">添加文件夹</System:String>
    <System:String x:Key="BtnRemoveSelected">删除选中</System:String>
    <System:String x:Key="BtnExpandAll">全部展开</System:String>
    <System:String x:Key="BtnCollapseAll">全部折叠</System:String>

    <!--打包-->
    <System:String x:Key="BtnBuild">打包</System:String>
    <System:String x:Key="BtnNewConfig">新建</System:String>
    <System:String x:Key="BtnImportConfig">导入配置</System:String>
    <System:String x:Key="BtnExportConfig">导出配置</System:String>

    <!--消息-->
    <System:String x:Key="MsgBuildSuccess">打包成功！\n输出文件：</System:String>
    <System:String x:Key="MsgBuildFailed">打包失败：</System:String>
    <System:String x:Key="MsgSelectSetupExe">请先选择 Setup.exe 路径</System:String>
    <System:String x:Key="MsgNoFiles">请至少添加一个安装文件</System:String>
    <System:String x:Key="MsgConfigSaved">配置已导出</System:String>
    <System:String x:Key="MsgConfigLoaded">配置已导入</System:String>
    <System:String x:Key="MsgConfirmNew">当前配置未保存，确定新建吗？</System:String>
    <System:String x:Key="MsgConfirmDelete">确定删除选中的文件/文件夹吗？</System:String>

    <!--Setup.exe 路径-->
    <System:String x:Key="LabelSetupExe">Setup.exe 路径</System:String>
    <System:String x:Key="BtnBrowseSetup">浏览...</System:String>

    <!--输出路径-->
    <System:String x:Key="LabelOutputPath">输出路径</System:String>
    <System:String x:Key="BtnBrowseOutput">浏览...</System:String>

    <!--状态栏-->
    <System:String x:Key="StatusReady">就绪</System:String>
    <System:String x:Key="StatusBuilding">正在打包...</System:String>
    <System:String x:Key="StatusBuildDone">打包完成</System:String>

    <!--Builder 界面语言切换-->
    <System:String x:Key="LabelBuilderLang">界面语言</System:String>
    <System:String x:Key="BuilderLangAuto">跟随系统</System:String>
    <System:String x:Key="BuilderLangZhCN">中文</System:String>
    <System:String x:Key="BuilderLangEnUS">English</System:String>

    <!--安装包语言设置-->
    <System:String x:Key="SectionLanguage">安装界面语言</System:String>
    <System:String x:Key="LangFollowSystem">跟随系统</System:String>
    <System:String x:Key="LangZhCN">简体中文</System:String>
    <System:String x:Key="LangEnUS">English</System:String>

    <!--样式配置-->
    <System:String x:Key="SectionStyle">界面样式</System:String>
    <System:String x:Key="StyleTabIcons">图标</System:String>
    <System:String x:Key="StyleTabInstall">安装阶段</System:String>
    <System:String x:Key="StyleTabUninstall">卸载阶段</System:String>
    <System:String x:Key="LabelHideTitleBar">隐藏左上角 Logo 与标题</System:String>
    <System:String x:Key="LabelBackground">背景图</System:String>
    <System:String x:Key="LabelCarousel">轮播图</System:String>
    <System:String x:Key="LabelButtonColor">按钮颜色</System:String>
    <System:String x:Key="BtnSelectImage">选择图片...</System:String>
    <System:String x:Key="BtnClearImage">清除</System:String>
    <System:String x:Key="BtnAddCarousel">添加图片</System:String>
    <System:String x:Key="BtnRemoveCarousel">移除</System:String>
    <System:String x:Key="StylePreview">预览</System:String>
    <System:String x:Key="StyleDefaultHint">(默认)</System:String>

    <!--压缩方式-->
    <System:String x:Key="LabelCompression">压缩方式</System:String>
    <System:String x:Key="CompressionLzma">LZMA（推荐）</System:String>
    <System:String x:Key="CompressionGZip">GZip</System:String>
    <System:String x:Key="CompressionDeflate">Deflate</System:String>
    <System:String x:Key="CompressionStore">不压缩</System:String>


</ResourceDictionary>
