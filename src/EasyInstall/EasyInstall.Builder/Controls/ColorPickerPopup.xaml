<UserControl x:Class="EasyInstall.Builder.Controls.ColorPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300" Background="White">

    <Border BorderBrush="#D0D7E0" BorderThickness="1" CornerRadius="6" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.18" Direction="270"/>
        </Border.Effect>

        <StackPanel Margin="12">

            <!-- ── HSV 区域：色块 + 色相条 ── -->
            <Grid Height="180">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="18"/>
                </Grid.ColumnDefinitions>

                <!-- 饱和度/明度色块 -->
                <Grid Grid.Column="0" x:Name="SvContainer" ClipToBounds="True">
                    <!-- 底层：当前色相的纯色 -->
                    <Rectangle x:Name="HueRect"/>
                    <!-- 白色横向渐变（左白→右透明） -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 黑色纵向渐变（上透明→下黑） -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 拖拽交互层 -->
                    <Canvas x:Name="SvCanvas"
                            Background="Transparent"
                            MouseDown="SvCanvas_MouseDown"
                            MouseMove="SvCanvas_MouseMove"
                            MouseUp="SvCanvas_MouseUp">
                        <!-- 光标圆圈 -->
                        <Ellipse x:Name="SvThumb"
                                 Width="12" Height="12"
                                 Stroke="White" StrokeThickness="2"
                                 Fill="Transparent"
                                 IsHitTestVisible="False"
                                 Canvas.Left="0" Canvas.Top="0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>

                <!-- 色相条 -->
                <Grid Grid.Column="2" x:Name="HueContainer" ClipToBounds="True">
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF0000" Offset="0"/>
                                <GradientStop Color="#FFFF00" Offset="0.167"/>
                                <GradientStop Color="#00FF00" Offset="0.333"/>
                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                <GradientStop Color="#0000FF" Offset="0.667"/>
                                <GradientStop Color="#FF00FF" Offset="0.833"/>
                                <GradientStop Color="#FF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- 色相拖拽层 -->
                    <Canvas x:Name="HueCanvas"
                            Background="Transparent"
                            MouseDown="HueCanvas_MouseDown"
                            MouseMove="HueCanvas_MouseMove"
                            MouseUp="HueCanvas_MouseUp">
                        <!-- 色相指示箭头 -->
                        <Border x:Name="HueThumb"
                                Width="18" Height="4"
                                Background="White"
                                BorderBrush="#888" BorderThickness="1"
                                CornerRadius="1"
                                IsHitTestVisible="False"
                                Canvas.Left="0" Canvas.Top="0">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.4"/>
                            </Border.Effect>
                        </Border>
                    </Canvas>
                </Grid>
            </Grid>

            <Rectangle Height="1" Fill="#E8ECF0" Margin="0,10,0,10"/>

            <!-- ── 预览 + 输入 ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 颜色预览块 -->
                <Border Grid.Column="0" x:Name="PreviewBlock"
                        Height="36" CornerRadius="4"
                        BorderBrush="#C8D0D8" BorderThickness="1"
                        Background="White"/>

                <!-- HEX + RGB 输入 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEX -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HEX" FontSize="10" Foreground="#888"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtHex"
                                 Height="24" Padding="5,2"
                                 FontSize="11"
                                 BorderBrush="#C8D0D8" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 MaxLength="7"
                                 TextChanged="TxtHex_TextChanged"/>
                    </Grid>

                    <!-- RGB -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RGB" FontSize="10" Foreground="#888"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtR"
                                 Height="24" Padding="3,2"
                                 FontSize="11" TextAlignment="Center"
                                 BorderBrush="#C8D0D8" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 MaxLength="3"
                                 TextChanged="TxtRGB_TextChanged"/>
                        <TextBox Grid.Column="3" x:Name="TxtG"
                                 Height="24" Padding="3,2"
                                 FontSize="11" TextAlignment="Center"
                                 BorderBrush="#C8D0D8" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 MaxLength="3"
                                 TextChanged="TxtRGB_TextChanged"/>
                        <TextBox Grid.Column="5" x:Name="TxtB"
                                 Height="24" Padding="3,2"
                                 FontSize="11" TextAlignment="Center"
                                 BorderBrush="#C8D0D8" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 MaxLength="3"
                                 TextChanged="TxtRGB_TextChanged"/>
                    </Grid>
                </Grid>
            </Grid>

            <Rectangle Height="1" Fill="#E8ECF0" Margin="0,10,0,10"/>

            <!-- ── 确定 / 取消 ── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="取消"
                        Width="64" Height="26" FontSize="12"
                        Margin="0,0,8,0"
                        Background="White" BorderBrush="#C8D0D8" BorderThickness="1"
                        Cursor="Hand" Click="BtnCancel_Click"/>
                <Button x:Name="BtnOK" Content="确定"
                        Width="64" Height="26" FontSize="12"
                        Background="#2C7BE5" Foreground="White"
                        BorderBrush="#1A6DD4" BorderThickness="1"
                        Cursor="Hand" Click="BtnOK_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
