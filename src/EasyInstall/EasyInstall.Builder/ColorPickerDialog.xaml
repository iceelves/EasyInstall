<Window x:Class="EasyInstall.Builder.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择颜色" Height="460" Width="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SwatchBtn" TargetType="Button">
            <Setter Property="Width"  Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#333"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 色板 -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- 渐变条 -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- 预览 -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- HEX 输入 -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- RGB 输入 -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- 按钮 -->
        </Grid.RowDefinitions>

        <!-- ── 色板 ── -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="色板" FontSize="11" Foreground="#666" Margin="0,0,0,6"/>
            <WrapPanel x:Name="SwatchPanel"/>
        </StackPanel>

        <!-- ── 灰度渐变条 ── -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="灰度" FontSize="11" Foreground="#666" Margin="0,0,0,6"/>
            <WrapPanel x:Name="GrayPanel"/>
        </StackPanel>

        <!-- ── 预览 ── -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="预览" FontSize="11" Foreground="#666"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Border Grid.Column="1" x:Name="PreviewBorder"
                    Height="32" CornerRadius="4"
                    BorderBrush="#C8D0D8" BorderThickness="1"
                    Background="White">
                <TextBlock x:Name="PreviewText"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" Foreground="#888" Text="未选择"/>
            </Border>
        </Grid>

        <!-- ── HEX 输入 ── -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="HEX" FontSize="11" Foreground="#666"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="TxtHex"
                     Height="28" Padding="6,2"
                     BorderBrush="#C8D0D8" BorderThickness="1"
                     VerticalContentAlignment="Center"
                     MaxLength="7"
                     TextChanged="TxtHex_TextChanged"/>
        </Grid>

        <!-- ── RGB 输入 ── -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="RGB" FontSize="11" Foreground="#666"
                       VerticalAlignment="Center"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="R" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>
                <TextBox Grid.Row="1" x:Name="TxtR" Height="28" Padding="4,2"
                         BorderBrush="#C8D0D8" BorderThickness="1"
                         VerticalContentAlignment="Center" TextAlignment="Center"
                         MaxLength="3" TextChanged="TxtRGB_TextChanged"/>
            </Grid>
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="G" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>
                <TextBox Grid.Row="1" x:Name="TxtG" Height="28" Padding="4,2"
                         BorderBrush="#C8D0D8" BorderThickness="1"
                         VerticalContentAlignment="Center" TextAlignment="Center"
                         MaxLength="3" TextChanged="TxtRGB_TextChanged"/>
            </Grid>
            <Grid Grid.Column="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="B" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>
                <TextBox Grid.Row="1" x:Name="TxtB" Height="28" Padding="4,2"
                         BorderBrush="#C8D0D8" BorderThickness="1"
                         VerticalContentAlignment="Center" TextAlignment="Center"
                         MaxLength="3" TextChanged="TxtRGB_TextChanged"/>
            </Grid>
        </Grid>

        <!-- ── 确定 / 取消 ── -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="取消" Width="72" Height="30"
                    Margin="0,0,8,0" Click="BtnCancel_Click"
                    Background="White" BorderBrush="#C8D0D8" BorderThickness="1"
                    Cursor="Hand"/>
            <Button x:Name="BtnOK" Content="确定" Width="72" Height="30"
                    Click="BtnOK_Click"
                    Background="#2C7BE5" Foreground="White"
                    BorderBrush="#1A6DD4" BorderThickness="1"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
