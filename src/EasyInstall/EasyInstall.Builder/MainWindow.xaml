<Window x:Class="EasyInstall.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:control="clr-namespace:EasyInstall.Core.Controls;assembly=EasyInstall.Core"
        xmlns:local="clr-namespace:EasyInstall.Builder.Controls"
        mc:Ignorable="d"
        Title="{DynamicResource BuilderTitle}"
        Height="700" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/EasyInstall.Core;component/images/Install.png"
        Background="#F0F2F5">

    <Window.Resources>
        <!-- 分组标题样式 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C5F8A"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
        <!-- 标签样式 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <!-- 输入框样式 -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="#C8D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- 工具栏按钮 -->
        <Style x:Key="ToolBtn" TargetType="control:IceButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ButtonCornerRadius" Value="4"/>
            <Setter Property="IsMouseOverFill" Value="#E8F4FD"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 主操作按钮 -->
        <Style x:Key="PrimaryBtn" TargetType="control:IceButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#2C7BE5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1A6DD4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ButtonCornerRadius" Value="4"/>
            <Setter Property="IsMouseOverFill" Value="#1A6DD4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 危险按钮 -->
        <Style x:Key="DangerBtn" TargetType="control:IceButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#D9534F"/>
            <Setter Property="BorderBrush" Value="#D9534F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ButtonCornerRadius" Value="4"/>
            <Setter Property="IsMouseOverFill" Value="#FFF0F0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 卡片面板 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E6ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#AAAAAA" BlurRadius="6" ShadowDepth="1" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TreeView 样式 -->
        <Style x:Key="FileTreeStyle" TargetType="local:MultiSelectTreeView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <!-- TreeViewItem：只绑定 IsExpanded（OneWay，不反写，让 WPF 原生控制展开/折叠）-->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneWay}"/>
            <Setter Property="Padding" Value="1,1"/>
            <Style.Triggers>
                <!-- 去掉原生蓝色选中高亮，选中状态由 CheckBox 表示 -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- TreeCheckBox：完全覆盖 App.xaml 的 IceCheckBoxStyle，使用紧凑原生模板 -->
        <Style x:Key="TreeCheckBox" TargetType="CheckBox" BasedOn="{x:Null}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Width="13" Height="13"
                                BorderBrush="#808E96AB" BorderThickness="1.5"
                                CornerRadius="2" Background="White"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="Check"
                                  Data="M2,6 L5,9 L11,3"
                                  Stroke="#69AFE7" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd"    Property="Background"    Value="#69AFE7"/>
                                <Setter TargetName="Bd"    Property="BorderBrush"   Value="#69AFE7"/>
                                <Setter TargetName="Check" Property="Visibility"    Value="Visible"/>
                                <Setter TargetName="Check" Property="Stroke"        Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#69AFE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>  <!-- 工具栏 -->
            <RowDefinition Height="*"/>   <!-- 主内容 -->
            <RowDefinition Height="28"/>  <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ══ 工具栏 ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E6ED" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <control:IceButton Style="{StaticResource ToolBtn}"
                                   Content="{DynamicResource BtnNewConfig}"
                                   Click="BtnNew_Click"/>
                <control:IceButton Style="{StaticResource ToolBtn}"
                                   Content="{DynamicResource BtnImportConfig}"
                                   Click="BtnImport_Click"/>
                <control:IceButton Style="{StaticResource ToolBtn}"
                                   Content="{DynamicResource BtnExportConfig}"
                                   Click="BtnExport_Click"/>
                <Separator Width="1" Background="#E0E6ED" Margin="4,4"/>
                <control:IceButton Style="{StaticResource PrimaryBtn}"
                                   Content="{DynamicResource BtnBuild}"
                                   Click="BtnBuild_Click"/>
            </StackPanel>
        </Border>

        <!-- ══ 主内容区 ════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="10,8,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左侧：配置表单 ─────────────────────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">

                    <!-- 基本信息 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionBasicInfo}" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LabelAppName}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtAppName" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LabelAppVersion}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtAppVersion" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource LabelCompany}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtCompany" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource LabelCompanySimplify}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtCompanySimplify" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource LabelWebsite}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtWebsite" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource LabelDefaultInstallDir}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TxtDefaultInstallDir" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource LabelRegistryKey}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TxtRegistryKey" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource LabelMainExecutable}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="7" Grid.Column="1" x:Name="TxtMainExecutable" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 快捷方式 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionShortcuts}" Style="{StaticResource SectionHeader}"/>
                            <CheckBox x:Name="ChkDesktopShortcut"   Content="{DynamicResource DesktopShortcut}"   Margin="0,4" IsChecked="True"/>
                            <CheckBox x:Name="ChkStartMenuShortcut" Content="{DynamicResource StartMenuShortcut}" Margin="0,4" IsChecked="True"/>
                            <CheckBox x:Name="ChkStartWithWindows"  Content="{DynamicResource StartWithWindows}"  Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- 图标 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionIcons}" Style="{StaticResource SectionHeader}"/>
                            <!-- 安装图标 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource LabelInstallIcon}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" BorderBrush="#C8D0D8" BorderThickness="1" CornerRadius="3" Height="26" Background="White">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <Image x:Name="ImgInstallIcon" Width="16" Height="16" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtInstallIconPath" Foreground="#888" FontSize="11" VerticalAlignment="Center" Text="(默认)"/>
                                    </StackPanel>
                                </Border>
                                <control:IceButton Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="4,0,4,0"
                                                   Content="{DynamicResource BtnSelectIcon}" Click="BtnSelectInstallIcon_Click"/>
                                <control:IceButton Grid.Column="3" Style="{StaticResource DangerBtn}" Margin="0"
                                                   Content="{DynamicResource BtnClearIcon}" Click="BtnClearInstallIcon_Click"/>
                            </Grid>
                            <!-- 卸载图标 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource LabelUninstallIcon}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" BorderBrush="#C8D0D8" BorderThickness="1" CornerRadius="3" Height="26" Background="White">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <Image x:Name="ImgUninstallIcon" Width="16" Height="16" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtUninstallIconPath" Foreground="#888" FontSize="11" VerticalAlignment="Center" Text="(默认)"/>
                                    </StackPanel>
                                </Border>
                                <control:IceButton Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="4,0,4,0"
                                                   Content="{DynamicResource BtnSelectIcon}" Click="BtnSelectUninstallIcon_Click"/>
                                <control:IceButton Grid.Column="3" Style="{StaticResource DangerBtn}" Margin="0"
                                                   Content="{DynamicResource BtnClearIcon}" Click="BtnClearUninstallIcon_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 协议 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionLicense}" Style="{StaticResource SectionHeader}"/>
                            <TextBox x:Name="TxtLicense" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="4" BorderBrush="#C8D0D8" BorderThickness="1"/>
                        </StackPanel>
                    </Border>

                    <!-- Setup.exe 路径 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LabelSetupExe}" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtSetupExe" Style="{StaticResource FieldBox}" IsReadOnly="True"/>
                                <control:IceButton Grid.Column="1" Style="{StaticResource ToolBtn}" Margin="6,0,0,0"
                                                   Content="{DynamicResource BtnBrowseSetup}" Click="BtnBrowseSetup_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 输出路径 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LabelOutputPath}" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtOutputPath" Style="{StaticResource FieldBox}" IsReadOnly="True"/>
                                <control:IceButton Grid.Column="1" Style="{StaticResource ToolBtn}" Margin="6,0,0,0"
                                                   Content="{DynamicResource BtnBrowseOutput}" Click="BtnBrowseOutput_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── 分隔条 ─────────────────────────────────────── -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#E0E6ED" Cursor="SizeWE"/>

            <!-- ── 右侧：文件树 ───────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource SectionFiles}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>

                    <!-- 文件操作工具栏 -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <control:IceButton Style="{StaticResource ToolBtn}"
                                           Content="{DynamicResource BtnAddFiles}"
                                           Click="BtnAddFiles_Click"/>
                        <control:IceButton Style="{StaticResource ToolBtn}"
                                           Content="{DynamicResource BtnAddFolder}"
                                           Click="BtnAddFolder_Click"/>
                        <control:IceButton Style="{StaticResource DangerBtn}"
                                           Content="{DynamicResource BtnRemoveSelected}"
                                           Click="BtnRemoveSelected_Click"/>
                        <Separator Width="1" Background="#E0E6ED" Margin="4,4"/>
                        <control:IceButton Style="{StaticResource ToolBtn}"
                                           Content="{DynamicResource BtnExpandAll}"
                                           Click="BtnExpandAll_Click"/>
                        <control:IceButton Style="{StaticResource ToolBtn}"
                                           Content="{DynamicResource BtnCollapseAll}"
                                           Click="BtnCollapseAll_Click"/>
                    </WrapPanel>

                    <!-- 文件树 -->
                    <local:MultiSelectTreeView Grid.Row="2" x:Name="FileTree"
                                               Style="{StaticResource FileTreeStyle}"
                                               ItemsSource="{Binding FileRoots}"
                                               VirtualizingStackPanel.IsVirtualizing="False">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <!-- 多选勾选框 -->
                                    <CheckBox Style="{StaticResource TreeCheckBox}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    <!-- 系统图标 -->
                                    <Image Source="{Binding Icon}" Width="16" Height="16"
                                           Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <!-- 名称 -->
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               FontSize="12"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </local:MultiSelectTreeView>

                </Grid>
            </Border>
        </Grid>

        <!-- ══ 状态栏 ══════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#F5F7FA" BorderBrush="#E0E6ED" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="{DynamicResource StatusReady}"
                       VerticalAlignment="Center" Margin="12,0" Foreground="#555" FontSize="12"/>
        </Border>
    </Grid>
</Window>
