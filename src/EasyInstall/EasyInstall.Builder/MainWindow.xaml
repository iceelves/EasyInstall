<Window x:Class="EasyInstall.Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:control="clr-namespace:EasyInstall.Core.Controls;assembly=EasyInstall.Core"
        xmlns:local="clr-namespace:EasyInstall.Builder.Controls"
        xmlns:model="clr-namespace:EasyInstall.Builder.Models"
        mc:Ignorable="d"
        Title="{DynamicResource BuilderTitle}"
        Height="700" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/EasyInstall.Core;component/images/Install.png"
        Background="#F0F2F5">

    <Window.Resources>
        <!-- 分组标题样式 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C5F8A"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
        <!-- 标签样式 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <!-- 输入框样式 -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="#C8D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- 工具栏按钮 -->
        <Style x:Key="ToolBtn" TargetType="control:IceButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ButtonCornerRadius" Value="4"/>
            <Setter Property="IsMouseOverFill" Value="#E8F4FD"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 主操作按钮 -->
        <Style x:Key="PrimaryBtn" TargetType="control:IceButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#2C7BE5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1A6DD4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ButtonCornerRadius" Value="4"/>
            <Setter Property="IsMouseOverFill" Value="#1A6DD4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 危险按钮 -->
        <Style x:Key="DangerBtn" TargetType="control:IceButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#D9534F"/>
            <Setter Property="BorderBrush" Value="#D9534F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ButtonCornerRadius" Value="4"/>
            <Setter Property="IsMouseOverFill" Value="#FFF0F0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 卡片面板 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E6ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#AAAAAA" BlurRadius="6" ShadowDepth="1" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TreeView 样式 -->
        <Style x:Key="FileTreeStyle" TargetType="local:MultiSelectTreeView">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8D0D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <!-- TreeViewItem：双向绑定 IsExpanded，手动展开/折叠时同步回 ViewModel，
             确保"全部展开/折叠"按钮能正确感知并触发状态变化 -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="1,1"/>
            <Style.Triggers>
                <!-- 去掉原生蓝色选中高亮，选中状态由 CheckBox 表示 -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- TreeCheckBox：完全覆盖 App.xaml 的 IceCheckBoxStyle，使用紧凑原生模板 -->
        <Style x:Key="TreeCheckBox" TargetType="CheckBox" BasedOn="{x:Null}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Width="13" Height="13"
                                BorderBrush="#808E96AB" BorderThickness="1.5"
                                CornerRadius="2" Background="White"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="Check"
                                  Data="M2,6 L5,9 L11,3"
                                  Stroke="#69AFE7" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd"    Property="Background"    Value="#69AFE7"/>
                                <Setter TargetName="Bd"    Property="BorderBrush"   Value="#69AFE7"/>
                                <Setter TargetName="Check" Property="Visibility"    Value="Visible"/>
                                <Setter TargetName="Check" Property="Stroke"        Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#69AFE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>  <!-- 工具栏 -->
            <RowDefinition Height="*"/>   <!-- 主内容 -->
            <RowDefinition Height="28"/>  <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ══ 工具栏 ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E6ED" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <!-- 左侧：操作按钮 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <control:IceButton Style="{StaticResource ToolBtn}"
                                       Content="{DynamicResource BtnNewConfig}"
                                       Click="BtnNew_Click"/>
                    <control:IceButton Style="{StaticResource ToolBtn}"
                                       Content="{DynamicResource BtnImportConfig}"
                                       Click="BtnImport_Click"/>
                    <control:IceButton Style="{StaticResource ToolBtn}"
                                       Content="{DynamicResource BtnExportConfig}"
                                       Click="BtnExport_Click"/>
                    <Separator Width="1" Background="#E0E6ED" Margin="4,4"/>
                    <control:IceButton Style="{StaticResource PrimaryBtn}"
                                       Content="{DynamicResource BtnBuild}"
                                       Click="BtnBuild_Click"/>
                </StackPanel>

                <!-- 右侧：Builder 界面语言切换 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource LabelBuilderLang}"
                               VerticalAlignment="Center"
                               Foreground="#666" FontSize="12" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbBuilderLang"
                              Width="100" Height="26"
                              Padding="6,2"
                              BorderBrush="#C8D0D8" BorderThickness="1"
                              VerticalContentAlignment="Center"
                              SelectionChanged="CmbBuilderLang_SelectionChanged">
                        <ComboBoxItem Tag=""      Content="{DynamicResource BuilderLangAuto}"/>
                        <ComboBoxItem Tag="zh-CN" Content="{DynamicResource BuilderLangZhCN}"/>
                        <ComboBoxItem Tag="en-US" Content="{DynamicResource BuilderLangEnUS}"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 主内容区 ════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="10,8,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左侧：配置表单 ─────────────────────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">

                    <!-- 基本信息 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionBasicInfo}" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LabelAppName}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtAppName" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LabelAppVersion}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtAppVersion" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource LabelCompany}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtCompany" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource LabelCompanySimplify}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TxtCompanySimplify" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource LabelWebsite}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TxtWebsite" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource LabelDefaultInstallDir}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TxtDefaultInstallDir" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource LabelRegistryKey}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TxtRegistryKey" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource LabelMainExecutable}" Style="{StaticResource FieldLabel}"/>
                                <TextBox   Grid.Row="7" Grid.Column="1" x:Name="TxtMainExecutable" Style="{StaticResource FieldBox}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 快捷方式 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionShortcuts}" Style="{StaticResource SectionHeader}"/>
                            <CheckBox x:Name="ChkDesktopShortcut"   Content="{DynamicResource DesktopShortcut}"   Margin="0,4" IsChecked="True"/>
                            <CheckBox x:Name="ChkStartMenuShortcut" Content="{DynamicResource StartMenuShortcut}" Margin="0,4" IsChecked="True"/>
                            <CheckBox x:Name="ChkStartWithWindows"  Content="{DynamicResource StartWithWindows}"  Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- 语言 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionLanguage}" Style="{StaticResource SectionHeader}"/>
                            <ComboBox x:Name="CmbLanguage" Height="26" Padding="6,2"
                                      BorderBrush="#C8D0D8" BorderThickness="1">
                                <ComboBoxItem x:Name="CmbLangAuto"   Content="{DynamicResource LangFollowSystem}" Tag=""/>
                                <ComboBoxItem x:Name="CmbLangZhCN"   Content="{DynamicResource LangZhCN}"         Tag="zh-CN"/>
                                <ComboBoxItem x:Name="CmbLangEnUS"   Content="{DynamicResource LangEnUS}"         Tag="en-US"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 样式配置（图标 + 安装/卸载样式） -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionStyle}" Style="{StaticResource SectionHeader}"/>
                            <TabControl x:Name="StyleTabControl" BorderThickness="0" Background="Transparent" Padding="0">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </TabControl.Resources>

                                <!-- ── Tab 1：图标 ── -->
                                <TabItem Header="{DynamicResource StyleTabIcons}">
                                    <StackPanel Margin="0,8,0,0">
                                        <!-- 隐藏标题栏 -->
                                        <CheckBox x:Name="ChkHideTitleBar" Content="{DynamicResource LabelHideTitleBar}" Margin="0,0,0,8"/>
                                        <!-- 安装图标 -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource LabelInstallIcon}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" BorderBrush="#C8D0D8" BorderThickness="1" CornerRadius="3" Height="26" Background="White">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                                    <Image x:Name="ImgInstallIcon" Width="16" Height="16" Margin="0,0,4,0"/>
                                                    <TextBlock x:Name="TxtInstallIconPath" Foreground="#888" FontSize="11" VerticalAlignment="Center" Text="{DynamicResource StyleDefaultHint}"/>
                                                </StackPanel>
                                            </Border>
                                            <control:IceButton Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="4,0,4,0"
                                                               Content="{DynamicResource BtnSelectIcon}" Click="BtnSelectInstallIcon_Click"/>
                                            <control:IceButton Grid.Column="3" Style="{StaticResource DangerBtn}" Margin="0"
                                                               Content="{DynamicResource BtnClearIcon}" Click="BtnClearInstallIcon_Click"/>
                                        </Grid>
                                        <!-- 卸载图标 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource LabelUninstallIcon}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" BorderBrush="#C8D0D8" BorderThickness="1" CornerRadius="3" Height="26" Background="White">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                                    <Image x:Name="ImgUninstallIcon" Width="16" Height="16" Margin="0,0,4,0"/>
                                                    <TextBlock x:Name="TxtUninstallIconPath" Foreground="#888" FontSize="11" VerticalAlignment="Center" Text="{DynamicResource StyleDefaultHint}"/>
                                                </StackPanel>
                                            </Border>
                                            <control:IceButton Grid.Column="2" Style="{StaticResource ToolBtn}" Margin="4,0,4,0"
                                                               Content="{DynamicResource BtnSelectIcon}" Click="BtnSelectUninstallIcon_Click"/>
                                            <control:IceButton Grid.Column="3" Style="{StaticResource DangerBtn}" Margin="0"
                                                               Content="{DynamicResource BtnClearIcon}" Click="BtnClearUninstallIcon_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </TabItem>

                                <!-- ── Tab 2：安装阶段 ── -->
                                <TabItem Header="{DynamicResource StyleTabInstall}">
                                    <StackPanel Margin="0,8,0,0">
                                        <!-- 背景图 -->
                                        <TextBlock Text="{DynamicResource LabelBackground}" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="#C8D0D8" BorderThickness="1" CornerRadius="3" Height="60" Background="#F5F5F5" ClipToBounds="True">
                                                <Image x:Name="ImgInstallBackground" Stretch="UniformToFill"/>
                                            </Border>
                                            <control:IceButton Grid.Column="1" Style="{StaticResource ToolBtn}" Margin="4,0,4,0" VerticalAlignment="Center"
                                                               Content="{DynamicResource BtnSelectImage}" Click="BtnSelectInstallBackground_Click"/>
                                            <control:IceButton Grid.Column="2" Style="{StaticResource DangerBtn}" Margin="0" VerticalAlignment="Center"
                                                               Content="{DynamicResource BtnClearImage}" Click="BtnClearInstallBackground_Click"/>
                                        </Grid>
                                        <!-- 按钮颜色 -->
                                        <TextBlock Text="{DynamicResource LabelButtonColor}" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" x:Name="InstallColorPreview" Height="26" CornerRadius="3" BorderBrush="#C8D0D8" BorderThickness="1" Background="White">
                                                <TextBlock x:Name="TxtInstallButtonColor" Text="{DynamicResource StyleDefaultHint}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="#888"/>
                                            </Border>
                                            <control:IceButton Grid.Column="1" Style="{StaticResource ToolBtn}" Margin="4,0,4,0"
                                                               Content="{DynamicResource BtnSelectImage}" Click="BtnPickInstallColor_Click"/>
                                            <control:IceButton Grid.Column="2" Style="{StaticResource DangerBtn}" Margin="0"
                                                               Content="{DynamicResource BtnClearImage}" Click="BtnClearInstallColor_Click"/>
                                        </Grid>
                                        <!-- 轮播图 -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{DynamicResource LabelCarousel}" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                            <control:IceButton HorizontalAlignment="Right" Style="{StaticResource ToolBtn}" Margin="0"
                                                               Content="{DynamicResource BtnAddCarousel}" Click="BtnAddInstallCarousel_Click"/>
                                        </Grid>
                                        <ListBox x:Name="LstInstallCarousel" Height="80" BorderBrush="#C8D0D8" BorderThickness="1"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="70" Margin="2">
                                                        <Image Source="{Binding}" Height="60" Stretch="UniformToFill"/>
                                                        <control:IceSvgButton Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                              ButtonImage="M954.304 190.336a15.552 15.552 0 0 1 0 21.952l-300.032 300.032 298.56 298.56a15.616 15.616 0 0 1 0 22.016l-120.96 120.896a15.552 15.552 0 0 1-21.952 0L511.36 655.232 214.272 952.32a15.552 15.552 0 0 1-21.952 0l-120.896-120.896a15.488 15.488 0 0 1 0-21.952l297.152-297.152L69.888 213.76a15.552 15.552 0 0 1 0-21.952l120.896-120.896a15.552 15.552 0 0 1 21.952 0L511.36 369.472l300.096-300.032a15.36 15.36 0 0 1 21.952 0l120.896 120.896z"
                                                                              NormalFill="White" IsMouseOverFill="#FF6060" IsMouseOverBackground="Transparent"
                                                                              Tag="{Binding}" Click="BtnRemoveInstallCarouselItem_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </TabItem>

                                <!-- ── Tab 3：卸载阶段 ── -->
                                <TabItem Header="{DynamicResource StyleTabUninstall}">
                                    <StackPanel Margin="0,8,0,0">
                                        <!-- 背景图 -->
                                        <TextBlock Text="{DynamicResource LabelBackground}" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="#C8D0D8" BorderThickness="1" CornerRadius="3" Height="60" Background="#F5F5F5" ClipToBounds="True">
                                                <Image x:Name="ImgUninstallBackground" Stretch="UniformToFill"/>
                                            </Border>
                                            <control:IceButton Grid.Column="1" Style="{StaticResource ToolBtn}" Margin="4,0,4,0" VerticalAlignment="Center"
                                                               Content="{DynamicResource BtnSelectImage}" Click="BtnSelectUninstallBackground_Click"/>
                                            <control:IceButton Grid.Column="2" Style="{StaticResource DangerBtn}" Margin="0" VerticalAlignment="Center"
                                                               Content="{DynamicResource BtnClearImage}" Click="BtnClearUninstallBackground_Click"/>
                                        </Grid>
                                        <!-- 按钮颜色 -->
                                        <TextBlock Text="{DynamicResource LabelButtonColor}" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" x:Name="UninstallColorPreview" Height="26" CornerRadius="3" BorderBrush="#C8D0D8" BorderThickness="1" Background="White">
                                                <TextBlock x:Name="TxtUninstallButtonColor" Text="{DynamicResource StyleDefaultHint}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="#888"/>
                                            </Border>
                                            <control:IceButton Grid.Column="1" Style="{StaticResource ToolBtn}" Margin="4,0,4,0"
                                                               Content="{DynamicResource BtnSelectImage}" Click="BtnPickUninstallColor_Click"/>
                                            <control:IceButton Grid.Column="2" Style="{StaticResource DangerBtn}" Margin="0"
                                                               Content="{DynamicResource BtnClearImage}" Click="BtnClearUninstallColor_Click"/>
                                        </Grid>
                                        <!-- 轮播图 -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{DynamicResource LabelCarousel}" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                            <control:IceButton HorizontalAlignment="Right" Style="{StaticResource ToolBtn}" Margin="0"
                                                               Content="{DynamicResource BtnAddCarousel}" Click="BtnAddUninstallCarousel_Click"/>
                                        </Grid>
                                        <ListBox x:Name="LstUninstallCarousel" Height="80" BorderBrush="#C8D0D8" BorderThickness="1"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="70" Margin="2">
                                                        <Image Source="{Binding}" Height="60" Stretch="UniformToFill"/>
                                                        <control:IceSvgButton Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                              ButtonImage="M954.304 190.336a15.552 15.552 0 0 1 0 21.952l-300.032 300.032 298.56 298.56a15.616 15.616 0 0 1 0 22.016l-120.96 120.896a15.552 15.552 0 0 1-21.952 0L511.36 655.232 214.272 952.32a15.552 15.552 0 0 1-21.952 0l-120.896-120.896a15.488 15.488 0 0 1 0-21.952l297.152-297.152L69.888 213.76a15.552 15.552 0 0 1 0-21.952l120.896-120.896a15.552 15.552 0 0 1 21.952 0L511.36 369.472l300.096-300.032a15.36 15.36 0 0 1 21.952 0l120.896 120.896z"
                                                                              NormalFill="White" IsMouseOverFill="#FF6060" IsMouseOverBackground="Transparent"
                                                                              Tag="{Binding}" Click="BtnRemoveUninstallCarouselItem_Click"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </TabItem>

                            </TabControl>
                        </StackPanel>
                    </Border>

                    <!-- 协议 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SectionLicense}" Style="{StaticResource SectionHeader}"/>
                            <TextBox x:Name="TxtLicense" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="4" BorderBrush="#C8D0D8" BorderThickness="1"/>
                        </StackPanel>
                    </Border>

                    <!-- Setup.exe 路径 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LabelSetupExe}" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtSetupExe" Style="{StaticResource FieldBox}" IsReadOnly="True"/>
                                <control:IceButton Grid.Column="1" Style="{StaticResource ToolBtn}" Margin="6,0,0,0"
                                                   Content="{DynamicResource BtnBrowseSetup}" Click="BtnBrowseSetup_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 输出路径 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LabelOutputPath}" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtOutputPath" Style="{StaticResource FieldBox}" IsReadOnly="True"/>
                                <control:IceButton Grid.Column="1" Style="{StaticResource ToolBtn}" Margin="6,0,0,0"
                                                   Content="{DynamicResource BtnBrowseOutput}" Click="BtnBrowseOutput_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── 分隔条 ─────────────────────────────────────── -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#E0E6ED" Cursor="SizeWE"/>

            <!-- ── 右侧：文件树 ───────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource SectionFiles}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>

                    <!-- 文件操作工具栏 -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <control:IceButton Style="{StaticResource ToolBtn}"
                                           Content="{DynamicResource BtnAddFiles}"
                                           Click="BtnAddFiles_Click"/>
                        <control:IceButton Style="{StaticResource ToolBtn}"
                                           Content="{DynamicResource BtnAddFolder}"
                                           Click="BtnAddFolder_Click"/>
                        <control:IceButton Style="{StaticResource DangerBtn}"
                                           Content="{DynamicResource BtnRemoveSelected}"
                                           Click="BtnRemoveSelected_Click"/>
                        <Separator Width="1" Background="#E0E6ED" Margin="4,4"/>
                        <control:IceButton Style="{StaticResource ToolBtn}"
                                           Content="{DynamicResource BtnExpandAll}"
                                           Click="BtnExpandAll_Click"/>
                        <control:IceButton Style="{StaticResource ToolBtn}"
                                           Content="{DynamicResource BtnCollapseAll}"
                                           Click="BtnCollapseAll_Click"/>
                    </WrapPanel>

                    <!-- 文件树 -->
                    <local:MultiSelectTreeView Grid.Row="2" x:Name="FileTree"
                                               Style="{StaticResource FileTreeStyle}"
                                               ItemsSource="{Binding FileRoots}"
                                               VirtualizingStackPanel.IsVirtualizing="False">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type model:FileTreeItem}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <!-- 多选勾选框 -->
                                    <CheckBox Style="{StaticResource TreeCheckBox}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                    <!-- 系统图标 -->
                                    <Image Source="{Binding Icon}" Width="16" Height="16"
                                           Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <!-- 名称 -->
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               FontSize="12"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </local:MultiSelectTreeView>

                </Grid>
            </Border>
        </Grid>

        <!-- ══ 状态栏 ══════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#F5F7FA" BorderBrush="#E0E6ED" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 状态文字 -->
                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Text="{DynamicResource StatusReady}"
                           VerticalAlignment="Center"
                           Foreground="#555" FontSize="12"
                           MinWidth="120"/>

                <!-- 进度条（打包时显示）-->
                <ProgressBar x:Name="BuildProgress" Grid.Column="1"
                             Height="6" Margin="10,0"
                             Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed"
                             Background="#E0E6ED"
                             Foreground="#2C7BE5"
                             BorderThickness="0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border x:Name="Root" CornerRadius="3"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0">
                                            <Border x:Name="PART_Track" CornerRadius="3">
                                                <Grid>
                                                    <Border x:Name="PART_Indicator"
                                                            HorizontalAlignment="Left"
                                                            CornerRadius="3"
                                                            Background="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- 百分比文字 -->
                <TextBlock x:Name="ProgressText" Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="#2C7BE5" FontSize="11"
                           Visibility="Collapsed"
                           MinWidth="36" TextAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
