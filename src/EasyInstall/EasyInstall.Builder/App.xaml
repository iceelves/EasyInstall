<Application x:Class="EasyInstall.Builder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EasyInstall.Builder"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--控件样式（不含语言，语言在 App.xaml.cs 里按系统动态加载）-->
                <ResourceDictionary Source="pack://application:,,,/EasyInstall.Core;component/Themes/IceButtonStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/EasyInstall.Core;component/Themes/IceSvgButtonStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/EasyInstall.Core;component/Themes/IceScrollViewerStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/EasyInstall.Core;component/Themes/IceCheckBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--全局默认样式-->
            <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource IceScrollViewerStyle}"/>
            <Style TargetType="{x:Type CheckBox}"     BasedOn="{StaticResource IceCheckBoxStyle}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
